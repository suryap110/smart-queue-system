{
  "name": "smart-queue-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade Smart Queue Management System (Government Hospital Enterprise Edition)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "chmod -R +x node_modules/.bin || true",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently --shell powershell.exe \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "cd apps/web && npx vite build",
    "build:api": "npm run build --workspace=apps/api",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "seed": "npm run seed --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
